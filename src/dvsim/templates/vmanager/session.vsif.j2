// Cadence vManager Verification Session Input Format (.vsif)
// Auto-generated by dvsim. Edit via `--vmanager-template` / DVSIM_VMANAGER_TEMPLATE.
//
// These tests were NOT executed by dvsim - load this file into vManager to run
// them. In flist mode the snapshot is compiled once per group (pre_group_script)
// and each test only runs it. The seed is randomized by vManager
// (sv_seed : random) and passed to the simulator as $ATTR(sv_seed).

session {{ session_name }} {
    top_dir : {{ top_dir }};
    output_mode : log_only;
};

{% for g in groups %}
group {{ g.name }} {
{% if g.compile_script %}
    // Compile the snapshot once for this group (file lists from dvsim/fusesoc).
    pre_group_script : "{{ g.compile_script }}";
{% endif %}
    sv_seed : random;
    timeout : {{ g.timeout_secs }}; // seconds

{% for t in g.tests %}
    test {{ t.test_name }} {
        // uvm_test: {{ t.uvm_test }}  uvm_test_seq: {{ t.uvm_test_seq }}
{% if t.count and t.count > 1 %}
        count : {{ t.count }}; // run N times, each with a fresh random seed
{% endif %}
        run_script : "{{ t.run_script }}";
{% if t.build_dir %}
        // build_dir: {{ t.build_dir }}
{% endif %}
{% if t.flist_file %}
        // flist_file: {{ t.flist_file }}
{% endif %}
        // dvsim make wrapper (alternative run_script): {{ t.make_cmd }}
    };

{% endfor %}
};

{% endfor %}
