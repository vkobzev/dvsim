// Cadence vManager Verification Session Input Format (.vsif)
// Auto-generated by dvsim. Edit `--vmanager-template` / DVSIM_VMANAGER_TEMPLATE
// to customise for your site/vManager version.
//
// These tests were NOT executed by dvsim. Load this file into vManager to run
// them there. In flist mode the snapshot is compiled once per group via
// pre_group_script; each test only runs it. The seed is randomized by vManager
// (sv_seed : random) and passed to the simulator as $BRUN_SV_SEED.

session {{ session_name }} {
    top_dir : {{ top_dir }};
    output_mode : log_only;
};

{% for g in groups %}
group {{ g.name }} {
{% if g.compile_script %}
    // Compile the snapshot once for this group (file lists from dvsim/fusesoc).
    pre_group_script : "{{ g.compile_script }}";

{% endif %}
    sv_seed : random;
    timeout : {{ g.timeout_secs }}; // seconds

{% for t in g.tests %}
    test {{ t.test_name }} {
        // uvm_test: {{ t.uvm_test }}  uvm_test_seq: {{ t.uvm_test_seq }}
{% if t.count and t.count > 1 %}
        count : {{ t.count }}; // run N times, each with a fresh random seed
{% endif %}
        run_script : "{{ t.run_script }}";
{% if t.build_dir %}
        // build_dir: {{ t.build_dir }}
{% endif %}
{% if t.flist_file %}
        // flist_file: {{ t.flist_file }}
{% endif %}
{% if t.pre_run_cmds %}
        // pre_run_cmds: {{ t.pre_run_cmds | join(" && ") }}
{% endif %}
{% if t.post_run_cmds %}
        // post_run_cmds: {{ t.post_run_cmds | join(" && ") }}
{% endif %}
        // Full dvsim make wrapper (alternative run_script):
        // run_script : "{{ t.make_cmd }}";
    };

{% endfor %}
};

{% endfor %}
